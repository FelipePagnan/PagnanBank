<Window x:Class="BankingSystem.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:BankingSystem.Desktop.Behaviors"
        Title="PagnanBank - Criar conta"
        Height="620" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,4,0,16">
            <TextBlock Text="Criar sua conta" Style="{StaticResource H1}" HorizontalAlignment="Center" />
            <TextBlock Text="Preencha os dados para abrir sua conta cliente" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="NOME COMPLETO" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="CPF (somente números)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="11" behaviors:TextBoxBehaviors.DigitsOnly="True" />

                <TextBlock Text="E-MAIL" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="SENHA (mínimo 6 caracteres)" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_OnPasswordChanged" />

                <TextBlock Text="CONFIRMAR SENHA" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <Button Content="Criar conta" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RegisterCommand}" Margin="0,20,0,0" IsDefault="True" />
                <Button Content="Cancelar" Style="{StaticResource NavButton}" Margin="0,8,0,0"
                        Foreground="{StaticResource MutedTextBrush}" HorizontalContentAlignment="Center"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
