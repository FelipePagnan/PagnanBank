<UserControl x:Class="BankingSystem.Desktop.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
            <TextBlock Text="Visão geral da sua conta" Style="{StaticResource Muted}" Margin="0,2,0,20" />

            <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryBrush}" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="SALDO DISPONÍVEL" Foreground="#BCD3EA" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}"
                               Foreground="White" FontSize="38" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding OwnerName}" Foreground="#DCE9F6" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Indicators -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Total investido" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TotalInvested, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Empréstimos em aberto" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding LoansOutstanding, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Limite diário" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DailyLimit, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Entradas x Saídas do mês -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Fluxo do mês (entradas × saídas)" Style="{StaticResource H2}" />

                    <Grid Margin="0,16,0,4" Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding MonthIncome, Converter={StaticResource DoubleToStar}}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{Binding MonthExpense, Converter={StaticResource DoubleToStar}}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="6,0,0,6" MinWidth="4" />
                        <Border Grid.Column="1" Width="2" Background="White" />
                        <Border Grid.Column="2" Background="{StaticResource DangerBrush}" CornerRadius="0,6,6,0" MinWidth="4" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Entradas: " Margin="6,0,0,0" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding MonthIncome, StringFormat={}{0:C}}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Saídas: " Margin="6,0,0,0" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding MonthExpense, StringFormat={}{0:C}}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Agência" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Branch}" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conta" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Number}" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
