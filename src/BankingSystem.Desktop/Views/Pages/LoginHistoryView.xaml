<UserControl x:Class="BankingSystem.Desktop.Views.Pages.LoginHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Histórico de Login" Style="{StaticResource H1}" />
            <TextBlock Text="Tentativas de acesso ao sistema" Style="{StaticResource Muted}" Margin="0,2,0,12" />
            <Button Content="Atualizar" Style="{StaticResource NavButton}" Width="120"
                    HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBrush}"
                    Command="{Binding RefreshCommand}" Margin="0,0,0,12" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeight="38" Background="White" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Width="170"
                                        Binding="{Binding TimestampUtc, StringFormat=dd/MM/yyyy HH:mm:ss}" />
                    <DataGridTextColumn Header="E-mail" Width="*" Binding="{Binding Email}" />
                    <DataGridTemplateColumn Header="Resultado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResultLabel}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Máquina" Width="200" Binding="{Binding Machine}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
