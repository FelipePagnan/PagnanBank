<UserControl x:Class="BankingSystem.Desktop.Views.Pages.CardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Cartões" Style="{StaticResource H1}" />
                <TextBlock Text="Emita, bloqueie, ajuste limite e pague a fatura" Style="{StaticResource Muted}" Margin="0,2,0,20" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"
                          Background="White" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Width="80" Binding="{Binding TypeLabel}" />
                        <DataGridTextColumn Header="Número" Width="170" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="Validade" Width="90" Binding="{Binding ExpiryLabel}" />
                        <DataGridTextColumn Header="Limite" Width="110" Binding="{Binding Limit, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Fatura" Width="110" Binding="{Binding UsedAmount, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Disponível" Width="120" Binding="{Binding AvailableLimit, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Status" Width="90" Binding="{Binding StatusLabel}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Emitir cartão" Style="{StaticResource H2}" />
                        <TextBlock Text="TIPO" Style="{StaticResource FieldLabel}" />
                        <ComboBox Height="38" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" />
                        <TextBlock Text="LIMITE (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewLimit, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Emitir" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                Command="{Binding IssueCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cartão selecionado" Style="{StaticResource H2}" />
                        <TextBlock Text="Selecione um cartão na lista." Style="{StaticResource Muted}" Margin="0,4,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Bloquear" Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource DangerBrush}" Command="{Binding BlockCommand}" />
                            <Button Grid.Column="2" Content="Desbloquear" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding UnblockCommand}" />
                        </Grid>

                        <TextBlock Text="NOVO LIMITE (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding LimitChange, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Ajustar limite" Style="{StaticResource NavButton}" Margin="0,12,0,0"
                                Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Width="150"
                                Command="{Binding SetLimitCommand}" />

                        <Button Content="Pagar fatura" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                Command="{Binding PayInvoiceCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
