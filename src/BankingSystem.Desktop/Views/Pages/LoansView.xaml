<UserControl x:Class="BankingSystem.Desktop.Views.Pages.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Empréstimos" Style="{StaticResource H1}" />
                <TextBlock Text="Contrate, acompanhe e pague suas parcelas" Style="{StaticResource Muted}" Margin="0,2,0,20" />
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Content="Pagar parcela" Style="{StaticResource SecondaryButton}"
                    Width="160" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding PayCommand}" />

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38"
                          Background="White" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Contratado" Width="110" Binding="{Binding ContractedAtUtc, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Valor" Width="110" Binding="{Binding Principal, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Taxa a.a." Width="80" Binding="{Binding AnnualRatePercent, StringFormat={}{0:0.##}%}" />
                        <DataGridTextColumn Header="Parcela" Width="110" Binding="{Binding InstallmentAmount, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Pagas" Width="80" Binding="{Binding PaidInstallments}" />
                        <DataGridTextColumn Header="Parcelas" Width="80" Binding="{Binding Installments}" />
                        <DataGridTextColumn Header="Em aberto" Width="120" Binding="{Binding Outstanding, StringFormat={}{0:C}}" />
                        <DataGridTextColumn Header="Status" Width="80" Binding="{Binding StatusLabel}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Contratar empréstimo" Style="{StaticResource H2}" />
                        <TextBlock Text="Saldo atual" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="16" />

                        <TextBlock Text="VALOR (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="TAXA ANUAL (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="PARCELAS" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Installments, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Contratar" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                Command="{Binding ContractCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Simulador de empréstimo" Style="{StaticResource H2}" />
                        <TextBlock Text="VALOR (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SimAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="TAXA ANUAL (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SimRate, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="PARCELAS" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SimInstallments, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Simular" Style="{StaticResource SecondaryButton}" Margin="0,16,0,8"
                                Command="{Binding SimulateCommand}" />
                        <TextBlock Text="{Binding SimResult}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
