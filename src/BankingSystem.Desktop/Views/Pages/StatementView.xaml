<UserControl x:Class="BankingSystem.Desktop.Views.Pages.StatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Extrato" Style="{StaticResource H1}" />
            <TextBlock Text="Últimas movimentações da conta" Style="{StaticResource Muted}" Margin="0,2,0,20" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Transactions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="40"
                      Background="White"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Width="150"
                                        Binding="{Binding TimestampUtc, StringFormat=dd/MM/yyyy HH:mm}" />
                    <DataGridTextColumn Header="Operação" Width="180"
                                        Binding="{Binding TypeLabel}" />
                    <DataGridTextColumn Header="Descrição" Width="*"
                                        Binding="{Binding Description}" />
                    <DataGridTemplateColumn Header="Valor" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayAmount}" VerticalAlignment="Center"
                                           Margin="8,0" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Saldo após" Width="140"
                                        Binding="{Binding BalanceAfter, StringFormat={}{0:C}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
