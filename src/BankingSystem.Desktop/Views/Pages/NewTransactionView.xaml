<UserControl x:Class="BankingSystem.Desktop.Views.Pages.NewTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Nova Transação" Style="{StaticResource H1}" />
        <TextBlock Text="Depósitos, saques, transferências e PIX" Style="{StaticResource Muted}" Margin="0,2,0,20" />

        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Conta de origem" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding AccountNumber}" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Saldo atual" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="OPERAÇÃO" Style="{StaticResource FieldLabel}" />
                <ComboBox Height="38" ItemsSource="{Binding Operations}"
                          SelectedItem="{Binding SelectedOperation}" />

                <TextBlock Text="VALOR (R$)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding RequiresDestination, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CONTA DE DESTINO (ex.: 10001-0)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DestinationNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="DESCRIÇÃO (opcional)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Confirmar operação" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExecuteCommand}" Margin="0,24,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
