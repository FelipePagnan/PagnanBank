<UserControl x:Class="BankingSystem.Desktop.Views.Pages.AdminUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BankingSystem.Desktop.Behaviors">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Users list -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Administração de Usuários" Style="{StaticResource H1}" />
                <TextBlock Text="Gerencie contas, bloqueios, permissões e saldo de teste" Style="{StaticResource Muted}" Margin="0,2,0,20" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Bloquear" Style="{StaticResource PrimaryButton}" Width="120"
                        Background="{StaticResource DangerBrush}" Command="{Binding BlockCommand}" />
                <Button Content="Desbloquear" Style="{StaticResource SecondaryButton}" Width="130"
                        Margin="10,0,0,0" Command="{Binding UnblockCommand}" />
                <Button Content="Excluir" Style="{StaticResource PrimaryButton}" Width="110"
                        Margin="10,0,0,0" Background="#7A1F1A" Command="{Binding DeleteCommand}" />
                <Button Content="Atualizar" Style="{StaticResource NavButton}" Width="100"
                        Margin="10,0,0,0" Foreground="{StaticResource PrimaryBrush}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          Background="White"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Width="*" Binding="{Binding FullName}" />
                        <DataGridTextColumn Header="E-mail" Width="*" Binding="{Binding Email}" />
                        <DataGridTextColumn Header="Perfil" Width="110" Binding="{Binding Role}" />
                        <DataGridTextColumn Header="Status" Width="90" Binding="{Binding Status}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Right column: balance adjust + new user -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Balance adjust -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ajuste de saldo (teste)" Style="{StaticResource H2}" />
                        <TextBlock Text="Selecione um usuário na lista ao lado." Style="{StaticResource Muted}" Margin="0,4,0,8"
                                   Visibility="{Binding HasSelectedAccount, Converter={StaticResource InverseBoolToVis}}" />

                        <StackPanel Visibility="{Binding HasSelectedAccount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Conta" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding SelectedAccountNumber}" Style="{StaticResource H2}" FontSize="16" Margin="0,2,0,0" />
                            <TextBlock Text="Saldo atual" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SelectedAccountBalance, StringFormat={}{0:C}}" Style="{StaticResource H2}" FontSize="18" Margin="0,2,0,0" />

                            <TextBlock Text="VALOR (R$)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AdjustAmount, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="MOTIVO (opcional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Adicionar" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CreditCommand}" />
                                <Button Grid.Column="2" Content="Remover" Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource DangerBrush}" Command="{Binding DebitCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- New user -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Novo usuário" Style="{StaticResource H2}" />

                        <TextBlock Text="NOME COMPLETO" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="CPF (somente números)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewCpf, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="11" behaviors:TextBoxBehaviors.DigitsOnly="True" />

                        <TextBlock Text="E-MAIL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="SENHA" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="SALDO INICIAL (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewInitialBalance, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="Perfil administrador" IsChecked="{Binding NewIsAdmin}"
                                  Margin="0,16,0,0" Foreground="{StaticResource TextBrush}" />

                        <Button Content="Criar usuário" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateCommand}" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
