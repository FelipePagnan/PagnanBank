<UserControl x:Class="BankingSystem.Desktop.Views.Pages.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Auditoria" Style="{StaticResource H1}" />
            <TextBlock Text="Registro das operações realizadas no sistema" Style="{StaticResource Muted}" Margin="0,2,0,12" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BUSCAR" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MÓDULO" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox Height="38" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="RESULTADO" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox Height="38" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" />
                    </StackPanel>
                    <Button Grid.Column="6" Content="Atualizar" Style="{StaticResource SecondaryButton}"
                            Width="120" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeight="38" Background="White" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Width="150"
                                        Binding="{Binding TimestampUtc, StringFormat=dd/MM/yyyy HH:mm}" />
                    <DataGridTextColumn Header="Usuário" Width="170" Binding="{Binding UserName}" />
                    <DataGridTextColumn Header="Operação" Width="130" Binding="{Binding Operation}" />
                    <DataGridTextColumn Header="Módulo" Width="120" Binding="{Binding Module}" />
                    <DataGridTextColumn Header="Resultado" Width="90" Binding="{Binding ResultLabel}" />
                    <DataGridTextColumn Header="Detalhes" Width="*" Binding="{Binding Details}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
